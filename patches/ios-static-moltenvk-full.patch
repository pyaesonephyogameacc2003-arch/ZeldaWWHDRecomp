From ee952fd4ca35a78a5103fcd236acabc7713d443f Mon Sep 17 00:00:00 2001
From: Grok <grok@x.ai>
Date: Sat, 7 Nov 2026 19:52:28 +0000
Subject: [PATCH] iOS: load static MoltenVK without SDL_Vulkan_LoadLibrary

---
 CMakeLists.txt                     | 25 +++++++++---
 runtime/src/gfx/vulkan/backend.cpp | 62 ++++++++++++++++++++++++++----
 2 files changed, 75 insertions(+), 12 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a43165d..60e6df8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,11 +1,15 @@
 cmake_minimum_required(VERSION 3.20)
 project(wwhd_recomp C CXX)
 
-# CMake must enable Objective-C++ before any dependency targets are created: bundled
-# Apple dependencies may contain .mm sources even when the app uses the Vulkan renderer.
+# iOS uses the portable SDL3 host and Vulkan through static MoltenVK.
+set(WWHD_IOS OFF)
 if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+  set(WWHD_IOS ON)
   enable_language(OBJCXX)
 endif()
+if(WWHD_IOS)
+  include(cmake/IOSDependencies.cmake)
+endif()
 # Renderers compiled into the executable:
 #   BOTH   (macOS default) Metal and Vulkan (MoltenVK) in one app; Graphics > Renderer picks one at start
 #   METAL  Metal only (macOS)
@@ -262,7 +266,11 @@ if(WWHD_HAS_METAL)
   set_source_files_properties(${IMGUI_METAL} PROPERTIES COMPILE_FLAGS "-fobjc-arc -w")
 endif()
 if(WWHD_HAS_VULKAN)
-  find_package(Vulkan 1.3 REQUIRED)
+  if(NOT WWHD_IOS)
+    find_package(Vulkan 1.3 REQUIRED)
+  elseif(NOT TARGET Vulkan::Vulkan)
+    message(FATAL_ERROR "iOS Vulkan target is missing; set WWHD_IOS_MOLTENVK_XCFRAMEWORK and WWHD_IOS_MOLTENVK_INCLUDE_DIR")
+  endif()
   if(NOT TARGET glslang::glslang)
     find_package(glslang CONFIG REQUIRED)
   endif()
@@ -387,8 +395,15 @@ if(WWHD_HAS_VULKAN)
       target_link_libraries(wwhd PRIVATE glslang::glslang glslang::SPIRV glslang::glslang-default-resource-limits)
     endif()
   elseif(APPLE)
-    # SDL host on a Mac: Homebrew's loader is linked; SDL and the renderer find it in the process
-    target_link_libraries(wwhd PRIVATE Vulkan::Vulkan glslang::glslang glslang::SPIRV glslang::glslang-default-resource-limits)
+    # SDL host on a Mac: Homebrew's loader is linked; SDL and the renderer find it in the process.
+    # iOS links static MoltenVK: force_load so the archive is retained under VK_NO_PROTOTYPES.
+    if(WWHD_IOS)
+      target_link_options(wwhd PRIVATE "LINKER:-force_load,$<TARGET_FILE:Vulkan::Vulkan>")
+      target_link_libraries(wwhd PRIVATE glslang::glslang glslang::SPIRV glslang::glslang-default-resource-limits)
+      target_include_directories(wwhd SYSTEM PRIVATE $<TARGET_PROPERTY:Vulkan::Vulkan,INTERFACE_INCLUDE_DIRECTORIES>)
+    else()
+      target_link_libraries(wwhd PRIVATE Vulkan::Vulkan glslang::glslang glslang::SPIRV glslang::glslang-default-resource-limits)
+    endif()
   else()
     # Windows, Linux, Android: SDL loads the Vulkan loader at run time (SDL_Vulkan_LoadLibrary);
     # only its headers are used here

diff --git a/runtime/src/gfx/vulkan/backend.cpp b/runtime/src/gfx/vulkan/backend.cpp
index 1111111..2222222 100644
--- a/runtime/src/gfx/vulkan/backend.cpp
+++ b/runtime/src/gfx/vulkan/backend.cpp
@@ -16,8 +16,8 @@
 #else
 #define WWHD_CREATE_WINDOW_SURFACE drivers::create_surface
 #endif
-#if defined(__APPLE__) && !defined(WWHD_SDL_HOST)
-#define VK_USE_PLATFORM_METAL_EXT  // VK_EXT_metal_surface: AppKit views' CAMetalLayers
+#if defined(__APPLE__) && (!defined(WWHD_SDL_HOST) || defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__))
+#define VK_USE_PLATFORM_METAL_EXT  // VK_EXT_metal_surface: AppKit/UIKit CAMetalLayers
 #endif
 #include "../../exception_report.h"
 #include "platform/present_observer.h"
@@ -80,6 +80,10 @@
 #include "platform/input_sdl.h"
 #include "overlay/window_target.h"
 #include <SDL3/SDL_vulkan.h>
+#endif
+#if defined(__APPLE__) && defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__)
+#include <dlfcn.h>
+#include <SDL3/SDL_metal.h>
 #endif
 #include "platform/display_rate.h"
 #include "platform/gaming_mode.h"
